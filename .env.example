# =============================================================================
# SendStack — .env.example
#
# Copy this file to .env (gitignored) and adjust values for your local setup.
# NEVER commit .env to the repository — it may contain secrets.
#
# Usage:
#   cp .env.example .env
#
# Most defaults work out of the box with DDEV. Override only what you need.
# =============================================================================

# Informational — matches the DDEV project name in .ddev/config.yaml
DDEV_PROJECT_NAME=sendstack

# WordPress admin credentials used by wp-setup.sh on first run.
# Change these if you want a different local admin account.
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=dev@example.com

# Title shown in WP Admin and the browser tab during local development.
WP_SITE_TITLE=SendStack Dev

# ── Future per-developer overrides ────────────────────────────────────────────
# Add variables here when they vary between developer machines.
# Examples (leave blank — filled in per developer):

# Override the DDEV primary URL if you run multiple DDEV projects
# and hit a port conflict. Leave blank to use the default.
# DDEV_PRIMARY_URL=

# Optional: path to a custom php.ini snippet to inject into DDEV.
# DDEV_PHP_INI_PATH=
