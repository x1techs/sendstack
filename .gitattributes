# =============================================================================
# SendStack — .gitattributes
#
# Two purposes:
#   1. Normalise line endings across macOS / Linux / Windows-WSL2
#   2. Exclude dev-only files from `git archive` (used by SVN deploy action)
# =============================================================================

# ── Default: auto-detect, normalise to LF on checkout ────────────────────────
* text=auto eol=lf

# ── Force LF (text files whose endings must be consistent) ───────────────────
*.php        text eol=lf
*.js         text eol=lf
*.mjs        text eol=lf
*.cjs        text eol=lf
*.ts         text eol=lf
*.jsx        text eol=lf
*.tsx        text eol=lf
*.json       text eol=lf
*.md         text eol=lf
*.txt        text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.sh         text eol=lf
*.bash       text eol=lf
*.css        text eol=lf
*.scss       text eol=lf
*.html       text eol=lf
*.xml        text eol=lf
*.svg        text eol=lf
*.sql        text eol=lf
Makefile     text eol=lf
Dockerfile   text eol=lf
# .pot files contain msgid/msgstr as text — treat as text, not binary
*.pot        text eol=lf
*.po         text eol=lf

# ── Force binary (never diff or merge these) ──────────────────────────────────
*.png        binary
*.jpg        binary
*.jpeg       binary
*.gif        binary
*.ico        binary
*.zip        binary
*.gz         binary
*.tar        binary
# Compiled translation files — binary (generated from .po)
*.mo         binary
*.woff       binary
*.woff2      binary
*.ttf        binary
*.eot        binary
*.otf        binary
*.pdf        binary

# ── export-ignore: excluded from `git archive` and SVN deploy ────────────────
# The 10up SVN deploy action calls `git archive` internally. Anything marked
# export-ignore here is excluded from the plugin zip sent to WordPress.org SVN.
# Keep this in sync with .distignore.
.ddev/               export-ignore
.github/             export-ignore
.gitignore           export-ignore
.gitattributes       export-ignore
.distignore          export-ignore
.editorconfig        export-ignore
.pre-commit-config.yaml export-ignore
.env.example         export-ignore
tests/               export-ignore
docs/                export-ignore
Makefile             export-ignore
composer.lock        export-ignore
package-lock.json    export-ignore
phpcs.xml.dist       export-ignore
phpstan.neon.dist    export-ignore
phpunit.xml.dist     export-ignore
webpack.config.js    export-ignore
CHANGELOG.md         export-ignore
CONTRIBUTING.md      export-ignore
# readme.md (GitHub) is excluded — readme.txt (WordPress.org format) is KEPT
readme.md            export-ignore
wordpress/           export-ignore
